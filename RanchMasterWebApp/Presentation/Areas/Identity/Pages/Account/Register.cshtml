@page
@using Presentation.Areas.Identity.Pages.Account
@model RegisterModel
@{
    ViewData["Title"] = "Registrarse";
}

<div class="animate-fade-in">
    <h2 class="mb-4">@ViewData["Title"]</h2>
    <p class="text-muted mb-5">Crear una nueva cuenta para acceder a Ranch Master</p>

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-semibold">Correo electrónico</label>
                            <input asp-for="Input.Email" class="form-control @(ViewData.ModelState["Input.Email"]?.Errors.Count > 0 ? "is-invalid" : "")" />
                            <span asp-validation-for="Input.Email" class="invalid-feedback"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label fw-semibold">Contraseña</label>
                            <input asp-for="Input.Password" class="form-control @(ViewData.ModelState["Input.Password"]?.Errors.Count > 0 ? "is-invalid" : "")" type="password" />
                            <span asp-validation-for="Input.Password" class="invalid-feedback"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Confirmar contraseña</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control @(ViewData.ModelState["Input.ConfirmPassword"]?.Errors.Count > 0 ? "is-invalid" : "")" type="password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="invalid-feedback"></span>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg py-2">Registrarse</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="text-center mt-4">
                <p class="mb-0">
                    ¿Ya tienes una cuenta? <a asp-page="/Account/Login" class="text-success fw-semibold">Iniciar sesión</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
