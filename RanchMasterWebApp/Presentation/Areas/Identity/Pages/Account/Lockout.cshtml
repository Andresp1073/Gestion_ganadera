@page
@using Presentation.Areas.Identity.Pages.Account
@model LockoutModel
@{
    ViewData["Title"] = "Bloqueado";
}

<div class="animate-fade-in text-center py-5">
    <i class="bi bi-shield-exclamation text-warning fs-1 mb-3 d-block"></i>
    <h2 class="mb-3">@ViewData["Title"]</h2>
    <p class="text-muted mb-4 lead">
        Esta cuenta ha sido bloqueada. Por favor, inténtelo de nuevo más tarde.
    </p>
    <a class="btn btn-primary" href="/">Volver al inicio</a>
</div>
