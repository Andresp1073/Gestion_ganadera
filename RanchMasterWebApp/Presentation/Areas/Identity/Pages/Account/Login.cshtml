@page
@using Presentation.Areas.Identity.Pages.Account
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="animate-fade-in">
    <h2 class="mb-4">@ViewData["Title"]</h2>
    <p class="text-muted mb-5">Accede a Ranch Master para administrar tu rancho</p>

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl" method="post" asp-antiforgery="true">
    @Html.AntiForgeryToken()
<div class="mb-3">
    <label asp-for="Input.Email" class="form-label fw-semibold">Correo electrónico</label>
    <input asp-for="Input.Email" class="form-control" />
    <span asp-validation-for="Input.Email" class="invalid-feedback"></span>
</div>
<div class="mb-3">
    <label asp-for="Input.Password" class="form-label fw-semibold">Contraseña</label>
    <input asp-for="Input.Password" class="form-control" type="password" />
    <span asp-validation-for="Input.Password" class="invalid-feedback"></span>
</div>
                    <div class="d-flex align-items-center mb-3">
                        <div class="form-check me-3">
                            <input asp-for="Input.RememberMe" class="form-check-input" />
                            <label asp-for="Input.RememberMe" class="form-check-label mb-0">Recordarme</label>
                        </div>
                        <a asp-page="ForgotPassword" class="ms-auto text-decoration-small text-muted">¿Olvidaste tu contraseña?</a>
                    </div>
<div class="d-grid">
    <button type="submit" class="btn btn-success btn-lg py-2">Iniciar sesión</button>
</div>
                    </form>
                </div>
            </div>
            <div class="text-center mt-4">
                <p class="mb-0">
                    ¿No tienes una cuenta? <a asp-page="/Account/Register" class="text-success fw-semibold">Crear una cuenta nueva</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
