@page
@using Presentation.Areas.Identity.Pages.Account
@model LogoutModel
@{
    ViewData["Title"] = "Cerrar sesión";
}

<div class="animate-fade-in text-center py-5">
    <i class="bi bi-check-circle-fill text-success fs-1 mb-3 d-block"></i>
    <h2 class="mb-3">@ViewData["Title"]</h2>
    <p class="text-muted mb-4 lead">
        Has cerrado sesión correctamente.
    </p>
    <a class="btn btn-success btn-lg" href="/">Volver al inicio</a>
</div>
