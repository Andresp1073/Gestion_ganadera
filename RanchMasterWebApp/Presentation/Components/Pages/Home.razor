@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Inicio</PageTitle>

@code {
    private bool IsAuthenticated = false;
    private string UserEmail = string.Empty;
    private List<CardInfo> cards = new()
    {
        new CardInfo("Animales", "Gestión de animales", "bi bi-emoji-smile", "Registre y administre todos sus animales, razas, edades y estados.", "/animals/list"),
        new CardInfo("Salud", "Registros médicos", "bi bi-heart-pulse", "Seguimiento de diagnósticos, tratamientos y vacunas para cada animal.", "/healthRecord/list"),
        new CardInfo("Reproducción", "Control de cría", "bi bi-egg", "Gestione fechas de apareamiento, nacimientos y seguimiento de crías.", "/Reproduction/list"),
        new CardInfo("Alimentación", "Horarios y detalles", "bi bi-cup-hot", "Programe y controle la alimentación de sus animales.", "/FeedingDetails/list"),
        new CardInfo("Ventas", "Registro de transacciones", "bi bi-cash-coin", "Controle las ventas, compradores y fechas de transacción.", "/sale/list"),
        new CardInfo("Ubicaciones", "Gestión de espacios", "bi bi-geo-alt", "Administre las ubicaciones y capacidades de su rancho.", "/location/list"),
        new CardInfo("Veterinarios", "Contactos médicos", "bi bi-calendar-check", "Gestione la información de contacto de los veterinarios.", "/Veterinarian/list"),
        new CardInfo("Razas", "Clasificación genética", "bi bi-diagram-3", "Administre razas, características y estadísticas.", "/Race/list")
    };

    private record CardInfo(string Titulo, string Subtitulo, string Icono, string Descripcion, string Url);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        IsAuthenticated = user.Identity?.IsAuthenticated ?? false;
        if (IsAuthenticated)
        {
            UserEmail = user.Identity?.Name ?? string.Empty;
        }
    }
}

<!-- Hero Section -->
<section class="py-5 mt-5 text-white animate-fade-in" style="
    background-image: url('images/Vacas.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    position: relative;
    overflow: hidden;
">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.35) 100%);"></div>
    <div class="container text-center py-5 position-relative">
        <h1 class="display-4 fw-bold text-white mb-4 animate-slide-down" style="font-family: var(--rm-font-heading);">Ranch Master</h1>
        <p class="lead mx-auto text-white animate-fade-in-up" style="max-width: 800px; animation-delay: 150ms;">
            Sistema integral para la gestión de su rancho. Administre animales, salud, reproducción, alimentación
            y ventas en un solo lugar.
        </p>
        @if (IsAuthenticated)
        {
            <div class="mt-4 animate-fade-in-up" style="animation-delay: 300ms;">
                <span class="text-success h5">Bienvenido, @UserEmail</span>
            </div>
        }
        else
        {
            <div class="mt-4 animate-fade-in-up" style="animation-delay: 300ms;">
                <a class="btn btn-light me-2" href="Identity/Account/Login" style="border-width: 2px;">
                    Iniciar sesión
                </a>
                <NavLink href="/about" class="btn btn-outline-light me-2" style="border-width: 2px;">
                    Acerca de Nosotros
                </NavLink>
            </div>
        }
    </div>
</section>

<section class="py-5">
    <div class="container">
        @if (IsAuthenticated)
        {
            <div class="row align-items-center mb-5 animate-fade-in-up">
                <div class="col-lg-6">
                    <span class="badge bg-light text-dark mb-2">Gestión Completa</span>
                    <h2 class="display-5 fw-bold">Todo lo que necesita para administrar su rancho</h2>
                    <p class="text-muted">
                        Ranch Master le permite gestionar todos los aspectos de su rancho, desde el seguimiento de animales
                        hasta la venta y reproducción.
                    </p>
                </div>
                <div class="col-lg-6 text-lg-end">
                    <NavLink href="/animals/list" class="btn btn-success">
                        Ver características <i class="bi bi-chevron-right"></i>
                    </NavLink>
                </div>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 stagger-children">
                @foreach (var card in cards)
                {
                    <div class="col">
                        <div class="card h-100 border-0">
                            <div class="card-header d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="card-title">@card.Titulo</h5>
                                    <h6 class="card-subtitle text-muted">@card.Subtitulo</h6>
                                </div>
                                <i class="@card.Icono text-success fs-4"></i>
                            </div>
                            <div class="card-body">
                                <p class="card-text text-muted small">@card.Descripcion</p>
                            </div>
                            <div class="card-footer bg-transparent border-top-0">
                                <NavLink href="@card.Url" class="text-success text-decoration-none small fw-semibold">Ver más <i class="bi bi-arrow-right"></i></NavLink>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 animate-fade-in">
                <div class="alert alert-info">
                    <h4>Acceso restringido</h4>
                    <p>Para acceder a las funcionalidades de Ranch Master, debe iniciar sesión primero.</p>
                    <a href="Identity/Account/Login" class="btn btn-primary">Iniciar Sesión</a>
                </div>
            </div>
        }
    </div>
</section>
