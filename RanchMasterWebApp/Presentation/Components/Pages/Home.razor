@page "/"

<PageTitle>Inicio</PageTitle>

<!-- Hero Section -->
<section class="py-5 mt-5 text-white" style="
    background-image: url('images/Vaca2.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
">
    <div class="container text-center py-4" style="background-color: rgba(0,0,0,0.4); padding: 2rem; border-radius: 12px;">
        <h1 class="display-4 fw-bold">Ranch Master</h1>
        <p class="lead mx-auto" style="max-width: 700px;">
            Sistema integral para la gestión de su rancho. Administre animales, salud, reproducción, alimentación
            y ventas en un solo lugar.
        </p>
        <div class="mt-4">
            <NavLink href="/about" class="btn btn-outline-light">Acerca de Nosotros</NavLink>
        </div>
    </div>
</section>


<!-- Features Section -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center mb-5">
            <div class="col-lg-6">
                <span class="badge bg-light text-dark mb-2">Gestión Completa</span>
                <h2 class="display-5 fw-bold">Todo lo que necesita para administrar su rancho</h2>
                <p class="text-muted">
                    Ranch Master le permite gestionar todos los aspectos de su rancho, desde el seguimiento de animales
                    hasta la venta y reproducción.
                </p>
            </div>
            <div class="col-lg-6 text-lg-end">
                <NavLink href="/animals/list" class="btn btn-success">
                    Ver características <i class="bi bi-chevron-right"></i>
                </NavLink>
            </div>
        </div>

        <!-- Cards Grid -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var card in cards)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="card-title">@card.Titulo</h5>
                                <h6 class="card-subtitle text-muted">@card.Subtitulo</h6>
                            </div>
                            <i class="@card.Icono text-success"></i>
                        </div>
                        <div class="card-body">
                            <p class="card-text text-muted small">@card.Descripcion</p>
                        </div>
                        <div class="card-footer bg-transparent border-top-0">
                            <NavLink href="@card.Url" class="text-success text-decoration-none small">Ver más</NavLink>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private List<CardInfo> cards = new()
    {
        new CardInfo("Animales", "Gestión de animales", "bi bi-emoji-smile", "Registre y administre todos sus animales, razas, edades y estados.", "/animals/list"),
        new CardInfo("Salud", "Registros médicos", "bi bi-heart-pulse", "Seguimiento de diagnósticos, tratamientos y vacunas para cada animal.", "/healthRecord/list"),
        new CardInfo("Reproducción", "Control de cría", "bi bi-egg", "Gestione fechas de apareamiento, nacimientos y seguimiento de crías.", "/Reproduction/list"),
        new CardInfo("Alimentación", "Horarios y detalles", "bi bi-cup-hot", "Programe y controle la alimentación de sus animales.", "/FeedingDetails/list"),
        new CardInfo("Ventas", "Registro de transacciones", "bi bi-cash-coin", "Controle las ventas, compradores y fechas de transacción.", "/sale/list"),
        new CardInfo("Ubicaciones", "Gestión de espacios", "bi bi-geo-alt", "Administre las ubicaciones y capacidades de su rancho.", "/location/list"),
        new CardInfo("Veterinarios", "Contactos médicos", "bi bi-calendar-check", "Gestione la información de contacto de los veterinarios.", "/Veterinarian/list"),
        new CardInfo("Razas", "Clasificación genética", "bi bi-diagram-3", "Administre razas, características y estadísticas.", "/Race/list")
    };

    private record CardInfo(string Titulo, string Subtitulo, string Icono, string Descripcion, string Url);
}
