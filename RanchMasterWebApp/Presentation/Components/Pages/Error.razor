@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="container py-5 animate-fade-in">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
            <i class="bi bi-exclamation-triangle-fill text-danger display-1 mb-4"></i>
            <h1 class="display-5 fw-bold text-danger mb-3">Error</h1>
            <h2 class="h4 text-muted mb-4">Ocurrió un error al procesar tu solicitud.</h2>

            @if (ShowRequestId)
            {
                <div class="alert alert-secondary text-start mb-4">
                    <strong>ID de solicitud:</strong> <code>@RequestId</code>
                </div>
            }

            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body text-start">
                    <h5 class="card-title">Modo de desarrollo</h5>
                    <p class="card-text text-muted small">
                        Cambiar al entorno de <strong>Desarrollo</strong> mostrará información más detallada sobre el error.
                    </p>
                    <p class="card-text text-muted small mb-0">
                        <strong class="text-danger">El entorno de desarrollo no debería activarse en aplicaciones implementadas.</strong>
                        Puede mostrar información sensible de excepciones a los usuarios finales.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code{
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
