@using Logic
@using Model
@inject NavigationManager NavManager

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-semibold">Lista de Veterinarios</h4>

        <div class="d-flex">
            <a href="/Veterinarians/create" class="btn btn-success me-2">+ Crear Veterinario</a>
            <button class="btn btn-outline-secondary" @onclick='() => NavManager.NavigateTo("/")'>
                ← Regresar al Inicio
            </button>
        </div>
    </div>

    <div class="table-responsive shadow-sm border rounded bg-white">
        <table class="table table-striped table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Nombre</th>
                <th scope="col">Teléfono</th>
                <th scope="col">Email</th>
                <th scope="col" style="width: 100px;">Opciones</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var vet in veterinarians)
            {
                <tr>
                    <td>@vet.IdVeterinarian</td>
                    <td>@vet.Name</td>
                    <td>@vet.Phone</td>
                    <td>@vet.Email</td>
                    <td>
                        <button class="btn btn-primary btn-sm w-100" @onclick="() => EditVeterinarian(vet.IdVeterinarian)">Editar</button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@code {
    List<VeterinariansEntity> veterinarians = new();

    protected override void OnInitialized()
    {
        veterinarians = new VeterinariansLog().VeterinarianList();
    }

    void EditVeterinarian(int id)
    {
        NavManager.NavigateTo($"/Veterinarian/update/{id}");
    }
}