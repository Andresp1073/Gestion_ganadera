@using Logic
@using Model
@inject NavigationManager NavManager

<EditForm Model="objFeedingSchedules" OnValidSubmit="SaveFeedingSchedule">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Fecha y hora de alimentación:</label>
        <InputDate @bind-Value="objFeedingSchedules.FeedingTime" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Detalle de alimentación:</label>
        <InputSelect @bind-Value="objFeedingSchedules.IdFeedingDetail" class="form-control">
            <option value="">Seleccione</option>
            @if (feedingDetails != null)
            {
            @foreach (var detail in feedingDetails)
            {
            <option value="@detail.IdFeedingDetail">@detail.FoodType - @detail.Quantity kg</option>
            }
            }
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
</EditForm>

@if (!string.IsNullOrEmpty(successMessage))
{
<div class="alert alert-success mt-3">@successMessage</div>
}

@code {
FeedingSchedulesEntity objFeedingSchedules = new();
List<FeedingDetailsEntity> feedingDetails = new();
private string? successMessage;

protected override async Task OnInitializedAsync()
{
feedingDetails = await Task.Run(() => new FeedingDetailsLog().FeedingDetailsList());
}

private void SaveFeedingSchedule()
{
try
{
FeedingSchedulesLog.CreateFeedingSheduleLog(objFeedingSchedules);
successMessage = $"¡Horario con ID = {objFeedingSchedules.IdSchedule} guardado correctamente!";
objFeedingSchedules = new();

}
catch (Exception ex)
{
successMessage = $"Error al guardar: {ex.Message}";
}
}
}