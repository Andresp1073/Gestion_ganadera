@using Logic
@using Model
@inject NavigationManager NavManager

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-semibold">Horarios de Alimentación</h4> @* Título ajustado con estilo *@
        @* Añadido botón "Crear Horario" similar a otras listas *@
        <a href="/FeedingSchedules/create" class="btn btn-success">+ Crear Horario</a>
    </div>

    @* No hay filtro en tu código original para este componente, así que no se añade una sección de filtro aquí.
       Si necesitas uno, puedes añadir una estructura similar a la del componente de reproducciones. *@

    <div class="table-responsive shadow-sm border rounded bg-white"> @* Contenedor de la tabla con estilos *@
        <table class="table table-striped table-bordered align-middle mb-0"> @* Estilo de tabla Bootstrap *@
            <thead class="table-light"> @* Cabecera de tabla con fondo claro *@
                <tr>
                    <th scope="col">ID</th> @* scope="col" para accesibilidad *@
                    <th scope="col">Fecha y Hora</th>
                    <th scope="col">Tipo de Alimento</th>
                    <th scope="col" style="width: 100px;">Opciones</th> @* Ancho fijo para la columna de opciones *@
                </tr>
            </thead>
            <tbody>
                @if (schedules != null && schedules.Any()) @* Verificación de datos para mostrar la tabla o un mensaje *@
                {
                    @foreach (var schedule in schedules)
                    {
                        <tr>
                            <td>@schedule.IdSchedule</td>
                            <td>@schedule.FeedingTime.ToString("dd/MM/yyyy HH:mm")</td> @* Formato de fecha y hora más específico *@
                            <td>@schedule.FeedingDetail?.FoodType</td>
                            <td>
                                <a class="btn btn-sm btn-primary w-100" href="@($"/FeedingSchedules/update/{schedule.IdSchedule}")">
                                    Editar @* Botón de editar con estilo y ancho completo *@
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">No hay horarios de alimentación disponibles.</td> @* Mensaje si no hay datos *@
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<FeedingSchedulesEntity> schedules = new();

    protected override async Task OnInitializedAsync() @* Cambiado a async Task para llamadas asíncronas *@
    {
        await LoadFeedingSchedules();
    }

    private async Task LoadFeedingSchedules()
    {
        try
        {
            var log = new FeedingSchedulesLog();
            schedules = await Task.Run(() => log.FeedingSchedulesList()); // Ejecutar en segundo plano si es sincrónico

            // Ordenar al cargar inicialmente
            schedules = schedules.OrderBy(s => s.FeedingTime).ToList(); // Ordenar por fecha y hora

            // Incluye detalles del alimento
            // Es más eficiente cargar FeedingDetails en un solo batch o desde la DBContext si es posible,
            // pero manteniendo tu lógica actual de carga uno por uno.
            foreach (var schedule in schedules)
            {
                schedule.FeedingDetail = await Task.Run(() => GetFeedingDetail(schedule.IdFeedingDetail));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar horarios de alimentación: {ex.Message}");
            schedules = new List<FeedingSchedulesEntity>(); // Asegurarse de que la lista no sea null en caso de error
        }
    }

    private void EditSchedule(int id)
    {
        NavManager.NavigateTo($"/FeedingSchedules/update/{id}");
    }

    // Este método debería idealmente cargar el detalle directamente si tienes acceso al contexto de la DB
    // O llamar a un método en Logic.FeedingDetailsLog si está disponible.
    private FeedingDetailsEntity GetFeedingDetail(int id)
    {
        // Usar using para asegurar que el contexto se deseche correctamente
        using var db = new Data.RanchMasterContext();
        return db.FeedingDetails.FirstOrDefault(fd => fd.IdFeedingDetail == id);
    }
}