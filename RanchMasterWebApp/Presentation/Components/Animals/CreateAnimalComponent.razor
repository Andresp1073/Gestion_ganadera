@using Logic
@using Model
@inject NavigationManager NavManager

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-semibold">Registrar Nuevo Animal</h4>
        <button class="btn btn-outline-secondary" @onclick='() => NavManager.NavigateTo("/animals/list")'>
            ← Regresar
        </button>
    </div>

    <div class="card shadow-sm border rounded bg-white">
        <div class="card-body">
            <EditForm Model="objAnimal" OnValidSubmit="SaveAnimal">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label for="gender" class="form-label">Género (M/H):</label>
                    <select id="gender" class="form-select" @bind="objAnimal.Gender">
                        <option value="" disabled hidden>Seleccione género</option>
                        <option value="M">Macho</option>
                        <option value="H">Hembra</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="age" class="form-label">Edad:</label>
                    <InputNumber id="age" class="form-control" @bind-Value="objAnimal.Age" />
                </div>

                <div class="mb-3">
                    <label for="status" class="form-label">Estado de salud:</label>
                    <InputText id="status" class="form-control" @bind-Value="objAnimal.Status" />
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Ubicación:</label>
                    <InputSelect id="location" class="form-select" @bind-Value="objAnimal.IdLocation">
                        <option value="" disabled hidden>Seleccione ubicación</option>
                        @foreach (var loc in locations)
                        {
                            <option value="@loc.IdLocation">@loc.Name</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label for="race" class="form-label">Raza:</label>
                    <InputSelect id="race" class="form-select" @bind-Value="objAnimal.IdRace">
                        <option value="" disabled hidden>Seleccione raza</option>
                        @foreach (var race in races)
                        {
                            <option value="@race.IdRace">@race.Name</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label for="feedingSchedule" class="form-label">Horario de Alimentación:</label>
                    <InputSelect id="feedingSchedule" class="form-select" @bind-Value="objAnimal.IdSchedule">
                        <option value="" disabled hidden>Seleccione horario</option>
                        @foreach (var schedule in feedingSchedules)
                        {
                            <option value="@schedule.IdSchedule">@schedule.FeedingTime.ToShortTimeString()</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-4">
                    <label for="reproduction" class="form-label">Reproducción:</label>
                    <InputSelect id="reproduction" class="form-select" @bind-Value="objAnimal.IdReproduction">
                        <option value="" disabled hidden>Seleccione reproducción</option>
                        @foreach (var reproduction in reproductions)
                        {
                            <option value="@reproduction.IdBreeding">Reproducción @reproduction.IdBreeding</option>
                        }
                    </InputSelect>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-success">Registrar Animal</button>
                </div>
            </EditForm>

            @if (successMessage != null)
            {
                <div class="alert alert-info mt-3">@successMessage</div>
            }
        </div>
    </div>
</div>

@code {
    AnimalsEntity objAnimal = new AnimalsEntity { Age = 0 };

    private string? successMessage;

    List<LocationsEntity> locations = new();
    List<RacesEntity> races = new();
    List<FeedingSchedulesEntity> feedingSchedules = new();
    List<ReproductionsEntity> reproductions = new();

    protected override async Task OnInitializedAsync()
    {
        locations = LocationsLog.LocationsList();
        races = new RacesLog().RacesList();
        feedingSchedules = new FeedingSchedulesLog().FeedingSchedulesList();
        reproductions = new ReproductionsLog().ReproductionsList();
    }

    private void SaveAnimal()
    {
        try
        {
            AnimalsLog.CreateAnimals(objAnimal);
            successMessage = "Registrado exitosamente";
            objAnimal = new AnimalsEntity { Age = 0 }; // Limpiar formulario
            NavManager.NavigateTo("/animals/list");
        }
        catch (Exception ex)
        {
            successMessage = $"Error al guardar el animal: {ex.Message}";
        }
    }
}
