@using Logic
@using Model
@inject NavigationManager NavManager

<h3>CreateAnimalComponent</h3>

<EditForm Model="objAnimal" OnValidSubmit="SaveAnimal">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>Género (M/H):</label>
        <select @bind="objAnimal.Gender" class="form-select">
            <option value="" selected disabled hidden></option>  @* placeholder vacío *@
            <option value="M">Macho</option>
            <option value="H">Hembra</option>
        </select>
    </div>

    <div>
        <label>Edad:</label>
        <InputNumber @bind-Value="objAnimal.Age" class="form-control" />
    </div>

    <div>
        <label>Estado:</label>
        <InputText @bind-Value="objAnimal.Status" class="form-control" />
    </div>

    <div>
        <label>Ubicación:</label>
        <InputSelect @bind-Value="objAnimal.IdLocation" class="form-select">
            @foreach (var loc in locations)
            {
                <option value="@loc.IdLocation">@loc.Name</option>
            }
        </InputSelect>
    </div>

    <div>
        <label>Raza:</label>
        <InputSelect @bind-Value="objAnimal.IdRace" class="form-select">
            @foreach (var race in races)
            {
                <option value="@race.IdRace">@race.Name</option>
            }
        </InputSelect>
    </div>

    <div>
        <label>Horario de Alimentación:</label>
        <InputSelect @bind-Value="objAnimal.IdSchedule" class="form-select">
            @foreach (var schedule in feedingSchedules)
            {
                <option value="@schedule.IdSchedule">@schedule.FeedingTime.ToShortTimeString()</option>
            }
        </InputSelect>
    </div>

    <div>
        <label>Reproducción:</label>
        <InputSelect @bind-Value="objAnimal.IdReproduction" class="form-select">
            @foreach (var reproduction in reproductions)
            {
                <option value="@reproduction.IdBreeding">Reproducción @reproduction.IdBreeding</option>
            }
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-primary">Guardar Animal</button>
</EditForm>

@if (successMessage != null)
{
    <div class="alert alert-info mt-2">@successMessage</div>
}

@code {
    // Objeto principal
    AnimalsEntity objAnimal = new AnimalsEntity { Age = 0 };

    private string? successMessage;

    List<LocationsEntity> locations = new();
    List<RacesEntity> races = new();
    List<FeedingSchedulesEntity> feedingSchedules = new();
    List<ReproductionsEntity> reproductions = new();

    protected override async Task OnInitializedAsync()
    {
        locations = new LocationsLog().LocationsList();
        races = new RacesLog().RacesList();
        feedingSchedules = new FeedingSchedulesLog().FeedingSchedulesList(); 
        reproductions = new ReproductionsLog().ReproductionsList();
    }

    private void SaveAnimal()
    {
        try
        {
            AnimalsLog.CreateAnimals(objAnimal);
            successMessage = "Registrado exitosamente";
            objAnimal = new AnimalsEntity { Age = 0 }; // Limpiar formulario
        }
        catch (Exception ex)
        {
            successMessage = $"Error al guardar el animal: {ex.Message}";
        }
    }
}
