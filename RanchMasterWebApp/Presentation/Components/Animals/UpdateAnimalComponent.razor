@using Logic
@using Model
@inject NavigationManager NavManager

<h3>Actualizar Animal</h3>

@if (notFound)
{
    <p><strong>Animal no encontrado.</strong></p>
}
else if (objAnimal != null)
{
    <EditForm Model="objAnimal" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Género:</label>
            <InputText class="form-control" @bind-Value="objAnimal.Gender" />
        </div>

        <div class="mb-3">
            <label class="form-label">Edad:</label>
            <InputNumber class="form-control" @bind-Value="objAnimal.Age" />
        </div>

        <div class="mb-3">
            <label class="form-label">Estado:</label>
            <InputText class="form-control" @bind-Value="objAnimal.Status" />
        </div>

        <div class="mb-3">
            <label class="form-label">Raza:</label>
            <InputSelect class="form-select" @bind-Value="objAnimal.IdRace">
                @foreach (var r in races)
                {
                    <option value="@r.IdRace">@r.Name</option>
                }
            </InputSelect>
        </div>

        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
    </EditForm>
}
else
{
    <p>Cargando datos del animal...</p>
}

@code {
    [Parameter]
    public int IdAnimal { get; set; } // Recibido desde UpdateAnimalPage

    private AnimalsEntity? objAnimal;
    private List<RacesEntity> races = new();
    private bool notFound = false;
    private readonly AnimalsLog animalsLog = new();
    private readonly RacesLog racesLog = new();

    protected override async Task OnInitializedAsync()
    {
        races = await Task.Run(() => racesLog.RacesList());
        objAnimal = await Task.Run(() => 
            animalsLog.AnimalsList().FirstOrDefault(a => a.IdAnimal == IdAnimal));

        if (objAnimal == null)
        {
            notFound = true;
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            animalsLog.UpdateAnimals(objAnimal!);
            await Task.Delay(500); // Pequeño retraso para feedback visual
            NavManager.NavigateTo("/animals/list");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al actualizar: {ex.Message}");
        }
    }
}