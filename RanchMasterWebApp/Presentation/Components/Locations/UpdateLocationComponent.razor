@using Logic
@using Model
@inject NavigationManager NavManager

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-semibold">Actualizar Ubicación</h4> @* Título ajustado *@
        <button class="btn btn-outline-secondary" @onclick='() => NavManager.NavigateTo("/Location/list")'>
            ← Regresar
        </button>
    </div>

    <div class="card shadow-sm border rounded bg-white"> 
        <div class="card-body"> 
            <EditForm Model="objLocation" OnValidSubmit="UpdateLocation" FormName="FrmLocation">
                <DataAnnotationsValidator />  
                <ValidationSummary />

                <div class="mb-3">
                    <label for="name" class="form-label fw-semibold">Nombre:</label>
                    <InputText id="name" @bind-Value="objLocation.Name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label for="type" class="form-label fw-semibold">Tipo:</label> 
                    <InputText id="type" @bind-Value="objLocation.Type" class="form-control" />
                </div>

                <div class="mb-3">
                    <label for="capacity" class="form-label fw-semibold">Capacidad:</label> 
                    <InputNumber id="capacity" @bind-Value="objLocation.Capacity" class="form-control" />
                </div>

                <div class="d-grid"> 
                    <button type="submit" class="btn btn-primary">Actualizar Ubicación</button> 
                </div>
            </EditForm>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert @(successMessage.Contains("Error") ? "alert-danger" : "alert-success") mt-3">@successMessage</div> 
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string IdLocation { get; set; } // Se mantiene como string según tu solicitud.

    LocationsEntity objLocation = new LocationsEntity();
    private string? successMessage;
    // No se usa 'errorMessage' separado, se gestiona con 'successMessage' y su contenido.

    protected override async Task OnInitializedAsync()
    {
        // Se mantiene la lógica original de tu código para el IdLocation como string.
        objLocation = await Task.Run(() => LocationsLog.LocationsList()
                          .FirstOrDefault(l => l.IdLocation.ToString() == IdLocation))
                      ?? new LocationsEntity(); // Si no se encuentra, inicializa una nueva entidad vacía.
    }

    private void UpdateLocation()
    {
        try
        {
            LocationsLog log = new();
            log.UpdateLocation(objLocation);

            successMessage = $"La ubicación '{objLocation?.Name}' se actualizó exitosamente!";
            objLocation = new LocationsEntity(); // Se mantiene esta línea según tu código original.
            NavManager.NavigateTo("/location/list");
        }
        catch (Exception ex)
        {
            // El mensaje de error ahora se asigna a successMessage para mantener el estilo original.
            successMessage = $"Error al actualizar la ubicación: {ex.InnerException?.Message ?? ex.Message}";
            Console.WriteLine($"Error al actualizar la ubicación: {ex.Message}");
        }
    }
}