@using Logic
@using Model
@inject NavigationManager NavManager

<h3>CreateLocationsComponent</h3>

<EditForm Model="objLocations" OnValidSubmit="SaveProduct" FormName="FrmProduct">
    <div>
        <label>Identifier Locations:</label>
        <InputNumber @bind-Value="objLocations.IdLocation" />
    </div>
    <div>
        <label>Name:</label>
        <InputText @bind-Value="objLocations.Name" />
    </div>
    <div>
        <label>Type:</label>
        <InputText @bind-Value="objLocations.Type" />
    </div>
    <div>
        <label>Capacity:</label>
        <InputNumber @bind-Value="objLocations.Capacity" />
    </div>
    
    <button type="submit">Guardar</button>
</EditForm>

@if (successMessage != null)
{
    <div>@successMessage</div>
}

@code {
    // Instancia del producto que se está creando
    LocationsEntity objLocations = new LocationsEntity();
    
    // Mensaje para indicar el resultado de la operación
    private string? successMessage;
    
    /*
     * Método que se ejecuta al enviar el formulario.
     * Guarda el producto en la base de datos.
     */
    private void SaveProduct()
    {
        try
        {
            // Llama al método para crear un producto en la capa lógica
            LocationsLog.CreateLocations(objLocations);

            // Muestra un mensaje de éxito
            successMessage = $"La localizacion '{objLocations?.Name}' se guardó exitosamente!";
            
            // Reinicia el formulario para un nuevo registro
            objLocations = new LocationsEntity();
        }
        catch (Exception ex)
        {
            // Muestra el mensaje de error en caso de excepción
            successMessage = $"Error al guardar el producto: {ex.Message}";
        }
    }
}
