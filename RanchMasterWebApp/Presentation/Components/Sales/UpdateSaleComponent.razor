@using Logic
@using Model
@inject NavigationManager NavManager

<h3>UpdateSaleComponent</h3>

<EditForm Model="objSale" OnValidSubmit="UpdateSale">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>Fecha de Venta:</label>
        <InputDate @bind-Value="objSale.SaleDateTime" />
    </div>

    <div>
        <label>Comprador:</label>
        <InputSelect @bind-Value="objSale.IdBuyer">
            <option value="">Seleccione</option>
            @foreach (var buyer in buyers)
            {
                <option value="@buyer.IdBuyer">@buyer.Name</option>
            }
        </InputSelect>
    </div>

    <div>
        <label>Animal:</label>
        <InputSelect @bind-Value="objSale.IdAnimal">
            <option value="">Seleccione</option>
            @foreach (var animal in animals)
            {
                <option value="@animal.IdAnimal">Animal @animal.IdAnimal</option>
            }
        </InputSelect>
    </div>

    <button type="submit">Actualizar Venta</button>
</EditForm>

@if (successMessage != null)
{
    <div>@successMessage</div>
}

@code {
    [Parameter]
    public int IdSale { get; set; }

    SalesEntity objSale = new();
    List<BuyersEntity> buyers = new();
    List<AnimalsEntity> animals = new();
    string? successMessage;

    protected override void OnInitialized()
    {
        buyers = new BuyersLog().BuyersList();
        animals = new AnimalsLog().AnimalsList();
        objSale = SalesLog.SalesList().FirstOrDefault(s => s.IdSale == IdSale) ?? new();
    }

    void UpdateSale()
    {
        try
        {
            new SalesLog().UpdateSales(objSale);
            successMessage = "¡Venta actualizada correctamente!";
            NavManager.NavigateTo("/sale/list");
        }
        catch (Exception ex)
        {
            successMessage = $"Error: {ex.Message}";
        }
    }
}