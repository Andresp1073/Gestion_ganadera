@using Logic
@using Model
@inject NavigationManager NavManager


<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-semibold">Lista de Ventas</h4> 

        <div class="d-flex">
            <a href="/Sales/create" class="btn btn-success me-2">+ Crear Venta</a>
            <button class="btn btn-outline-secondary" @onclick='() => NavManager.NavigateTo("/")'>
                ← Regresar al Inicio
            </button>
        </div>
    </div>

    <div class="table-responsive shadow-sm border rounded bg-white"> 
        <table class="table table-striped table-bordered align-middle mb-0"> 
            <thead class="table-light"> 
                <tr>
                    <th scope="col">ID Venta</th> 
                    <th scope="col">Fecha</th>
                    <th scope="col">Comprador</th>
                    <th scope="col">Animal (ID)</th> 
                    <th scope="col" style="width: 100px;">Opciones</th> 
                </tr>
            </thead>
            <tbody>
                @if (sales != null && sales.Any())
                {
                    @foreach (var sale in sales)
                    {
                        <tr>
                            <td>@sale.IdSale</td>
                            <td>@(sale.SaleDateTime.ToString("dd/MM/yyyy"))</td>
                            <td>@buyers.FirstOrDefault(b => b.IdBuyer == sale.IdBuyer)?.Name</td>
                            <td>Animal @sale.IdAnimal</td> 
                            <td>
  
                                <a class="btn btn-sm btn-primary w-100" href="@($"/Sale/update/{sale.IdSale}")">
                                    Editar
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No hay ventas disponibles.</td> 
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<SalesEntity> sales = new();
    private List<BuyersEntity> buyers = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Cargar datos de forma asíncrona
            sales = await Task.Run(() => SalesLog.SalesList());
            buyers = await Task.Run(() => new BuyersLog().BuyersList());


            if (sales == null) sales = new List<SalesEntity>();
            if (buyers == null) buyers = new List<BuyersEntity>();

            // Opcional: Ordenar las ventas al cargar, por ejemplo por fecha o ID
            sales = sales.OrderByDescending(s => s.SaleDateTime).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar ventas: {ex.Message}");

            sales = new List<SalesEntity>();
            buyers = new List<BuyersEntity>();
           
        }
    }

    
}