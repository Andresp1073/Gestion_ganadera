@using Logic
@using Model
@inject NavigationManager NavManager

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-semibold">Lista de Historiales de Salud</h4> @* Título ajustado con estilo *@
        @* Añadido botón "Crear Historial" similar a otras listas *@
        <a href="/HealthRecord/create" class="btn btn-success">+ Crear Historial</a>
    </div>

    @* No se añade una sección de filtro por estado aquí, ya que no estaba presente en tu código original
       y no se especificó un campo de filtro para Historiales de Salud. *@

    <div class="table-responsive shadow-sm border rounded bg-white"> @* Contenedor de la tabla con estilos *@
        <table class="table table-striped table-bordered align-middle mb-0"> @* Estilo de tabla Bootstrap *@
            <thead class="table-light"> @* Cabecera de tabla con fondo claro *@
                <tr>
                    <th scope="col">ID</th> @* scope="col" para accesibilidad *@
                    <th scope="col">Diagnóstico</th>
                    <th scope="col">Tratamiento</th>
                    <th scope="col">Veterinario</th>
                    <th scope="col">Vacunas</th>
                    <th scope="col">Animal (ID)</th> @* Ajustado el texto para reflejar que es el ID del animal *@
                    <th scope="col" style="width: 100px;">Opciones</th> @* Ancho fijo para la columna de opciones *@
                </tr>
            </thead>
            <tbody>
                @if (healthRecords != null && healthRecords.Any()) @* Verificación de datos para mostrar la tabla o un mensaje *@
                {
                    @foreach (var record in healthRecords)
                    {
                        <tr>
                            <td>@record.IdHealth</td>
                            <td>@record.Diagnosis</td>
                            <td>@record.Treatment</td>
                            <td>@record.Veterinarians?.Name</td> @* Asumiendo que Veterinarians tiene una propiedad Name *@
                            <td>@record.Vaccines</td>
                            <td>@record.Animals?.IdAnimal</td> @* Se añadió '?' para seguridad si Animals puede ser null *@
                            <td>
                                <a class="btn btn-sm btn-primary w-100" href="@($"/HealthRecords/update/{record.IdHealth}")">
                                    Editar @* Botón de editar con estilo y ancho completo *@
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No hay historiales de salud disponibles.</td> @* Mensaje si no hay datos, colspan ajustado *@
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<HealthsRecordsEntity> healthRecords = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var healthRecordsLog = new HealthRecordsLog();

            // Obtener la lista de historiales de salud con las relaciones cargadas
            healthRecords = await Task.Run(() => healthRecordsLog.HealthsRecordsList());

            // Ordenar por ID
            healthRecords = healthRecords.OrderBy(hr => hr.IdHealth).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar historiales de salud: {ex.Message}");
            healthRecords = new List<HealthsRecordsEntity>(); // Asegurarse de que la lista no sea null en caso de error
        }
    }
}