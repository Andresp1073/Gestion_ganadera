@using Logic
@using Model
@inject NavigationManager NavManager
<h3>Crear Detalle de Alimentación</h3>

<EditForm Model="objFeedingDetails" OnValidSubmit="SaveDetail">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Tipo de Alimento:</label>
        <InputText @bind-Value="objFeedingDetails.FoodType" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Cantidad (kg):</label>
        <InputNumber @bind-Value="objFeedingDetails.Quantity" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
</EditForm>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-info mt-3">@successMessage</div>
}

@code {
    FeedingDetailsEntity objFeedingDetails = new FeedingDetailsEntity();
    private string? successMessage;

    private void SaveDetail()
    {
        try
        {
            FeedingDetailsLog.CreateFeedingDetails(objFeedingDetails);
            successMessage = "¡Detalle registrado correctamente!";

            // Reiniciar formulario
            objFeedingDetails = new FeedingDetailsEntity();

            // Volver al listado
            NavManager.NavigateTo("/FeedingDetails/list");
        }
        catch (Exception ex)
        {
            successMessage = $"Error al guardar: {ex.Message}";
        }
    }
}