@using Logic
@using Model
@inject NavigationManager NavManager
<h3>CreateFeedingDetailComponent</h3>

<EditForm Model="objFeedingDetails" OnValidSubmit="SaveProduct" FormName="FrmProduct">
    <div>
        <label>Identifier:</label>
        <InputNumber @bind-Value="objFeedingDetails.IdFeedingDetail" />
    </div>
    <div>
        <label>Food Type:</label>
        <InputText @bind-Value="objFeedingDetails.FoodType" />
    </div>
    <div>
        <label>Quantity:</label>
        <InputNumber @bind-Value="objFeedingDetails.Quantity" />
    </div>
    
    <button type="submit">Guardar</button>
</EditForm>

@if (successMessage != null)
{
    <div>@successMessage</div>
}

@code {
    // Instancia del producto que se está creando
    FeedingDetailsEntity objFeedingDetails = new FeedingDetailsEntity();
    
    // Mensaje para indicar el resultado de la operación
    private string? successMessage;
    
    /*
     * Método que se ejecuta al enviar el formulario.
     * Guarda el producto en la base de datos.
     */
    private void SaveProduct()
    {
        try
        {
            // Llama al método para crear un producto en la capa lógica
            FeedingDetailsLog.CreateFeedingDetails(objFeedingDetails);

            // Muestra un mensaje de éxito
            successMessage = $"Los detalles de alimentacion '{objFeedingDetails?.IdFeedingDetail}' se guardó con exitó";
            
            // Reinicia el formulario para un nuevo registro
            objFeedingDetails = new FeedingDetailsEntity();
            
        }
        catch (Exception ex)
        {
            // Muestra el mensaje de error en caso de excepción
            successMessage = $"Error al guardar el producto: {ex.Message}";
        }
    }
}