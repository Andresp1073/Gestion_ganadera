@using Logic
@using Model
@using Model.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
    <div class="container-fluid px-4 d-flex align-items-center">
        <a class="navbar-brand d-flex align-items-center m-0" href="/" style="text-decoration: none;">
            <span class="fw-bold fs-4 text-success me-1">Ranch</span>
            <span class="fw-bold fs-4 text-success">Master</span>
        </a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <AuthorizeView>
                <Authorized>
                    <ul class="navbar-nav me-auto ms-3 d-flex align-items-center">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" id="animalManagementDropdown"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Gestión Animal
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="animalManagementDropdown">
                                <li><a class="dropdown-item" href="/animals/list">Animales</a></li>
                                <li><a class="dropdown-item" href="/Race/list">Razas</a></li>
                                <li><a class="dropdown-item" href="/Reproduction/list">Reproducción</a></li>
                                <li><a class="dropdown-item" href="/healthRecord/list">Salud</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" id="operationsDropdown"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Operación
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="operationsDropdown">
                                <li><a class="dropdown-item" href="/FeedingDetails/list">Alimentación</a></li>
                                <li><a class="dropdown-item" href="/FeedingSchedules/list">Horario de alimentación</a></li>
                                <li><a class="dropdown-item" href="/location/list">Ubicaciones</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" id="commercialDropdown"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Comercial
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="commercialDropdown">
                                <li><a class="dropdown-item" href="/sale/list">Ventas</a></li>
                                <li><a class="dropdown-item" href="/buyer/list">Compradores</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-medium" href="#" id="contactsDropdown"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Contactos
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="contactsDropdown">
                                <li><a class="dropdown-item" href="/Veterinarian/list">Veterinarios</a></li>
                            </ul>
                        </li>
                    </ul>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized>
                    <div class="dropdown d-flex align-items-center">
                        <button class="avatar-circle" type="button" id="userDropdown"
                                data-bs-toggle="dropdown" aria-expanded="false" title="Mi Perfil">
                            @initials
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="/profile">
                                <i class="bi bi-person me-2"></i>Mi Perfil
                            </a></li>
                            <li><hr class="dropdown-divider"/></li>
                            <li>
                                <form action="/Identity/Account/Logout?returnUrl=/" method="post" class="m-0">
                                    <AntiforgeryToken />
                                    <button type="submit" class="dropdown-item text-danger btn btn-link w-100 text-start" style="text-decoration: none;">
                                        <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

<style>
    .navbar {
        min-height: 4.5rem;
        z-index: 1030;
    }

    .navbar .dropdown-menu {
        z-index: 1040;
    }

    .navbar .navbar-brand {
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
        line-height: 1.5;
    }

    .navbar .navbar-collapse {
        align-items: center;
    }

    .nav-link {
        padding: 0.5rem 0.75rem !important;
        font-size: 1rem;
        font-weight: 500;
        transition: color 0.2s ease;
    }

    .nav-link:hover {
        color: #198754 !important;
    }

    .dropdown-menu {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        border: none;
    }

    .dropdown-item {
        padding: 0.5rem 1rem;
        font-size: 0.95rem;
    }

    .dropdown-item:hover {
        background-color: #f8f9fa;
        color: #198754;
    }

    button.dropdown-item:focus, button.dropdown-item:active {
        background-color: transparent;
        color: #dc3545;
    }

    .avatar-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background-color: #15803d;
        color: #fff;
        font-weight: 700;
        font-size: 0.85rem;
        font-family: 'Nunito', sans-serif;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 2px solid transparent;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        padding: 0;
        line-height: 1;
    }

    .avatar-circle:hover {
        border-color: #22c55e;
        box-shadow: 0 0 0 3px rgba(21, 128, 61, 0.2);
    }

    .avatar-circle:focus-visible {
        outline: none;
        border-color: #22c55e;
        box-shadow: 0 0 0 3px rgba(21, 128, 61, 0.3);
    }

    @@media (max-width: 991.98px) {
        .navbar-collapse {
            background-color: white;
            padding: 1rem;
            border-radius: 8px;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
            margin-top: 0.5rem;
        }

        .navbar-nav {
            align-items: flex-start !important;
        }

        .navbar .d-flex.align-items-center {
            justify-content: flex-start;
            width: 100%;
            margin-top: 0.5rem;
        }
    }
</style>

@code {
    private string initials = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var name = authState.User.Identity?.Name;
        if (!string.IsNullOrEmpty(name))
            initials = name.Length >= 2
                ? name[..2].ToUpperInvariant()
                : name[0].ToString().ToUpperInvariant();
    }
}
