@using Logic
@using Model
@inject NavigationManager NavManager

<h3>CreateReproductionsComponent</h3>

<EditForm Model="objReproduction" OnValidSubmit="SaveProduct" FormName="FrmProduct">
    <div>
        <label>Mathing Date:</label>
        <InputDate @bind-Value="objReproduction.MatingDate" />
    </div>
    <div>
        <label>Number of spring:</label>
        <InputNumber @bind-Value="objReproduction.NumberOffspring" />
    </div>
    <div>
        <label>Status:</label>
        <InputText @bind-Value="objReproduction.Status" />
    </div>
    <div>
        <label>Birthdate:</label>
        <InputDate @bind-Value="objReproduction.Birthdate" />
    </div>
    
    <button type="submit">Guardar</button>
</EditForm>

@if (successMessage != null)
{
    <div>@successMessage</div>
}

@code {
    // Instancia de la reproduccion que se está creando
    ReproductionsEntity objReproduction = new ReproductionsEntity();

    // Mensaje para indicar el resultado de la operación
    private string? successMessage;
    
    /*
     * Método que se ejecuta al enviar el formulario.
     * Guarda el producto en la base de datos.
     */
    private void SaveProduct()
    {
        try
        {
            // Llama al método para crear un producto en la capa lógica
            ReproductionsLog.CreateReproductions(objReproduction);

            // Muestra un mensaje de éxito
            successMessage = $"Registrado exitosamente";

            // Reinicia el formulario para un nuevo registro
            objReproduction = new ReproductionsEntity();
            //Redirecciona a la lista
            NavManager.NavigateTo("/Reproduction/list");
        }
        catch (Exception ex)
        {
            // Muestra el mensaje de error en caso de excepción
            successMessage = $"Error al guardar el veterinario: {ex.InnerException?.Message ?? ex.Message}";
        }
    }
}