@using Logic
@using Model
@inject NavigationManager NavManager

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-semibold">Lista de Reproducciones</h4>

        <div class="d-flex">
            <a href="/Reproductions/create" class="btn btn-success me-2">+ Crear Reproducción</a>
            <button class="btn btn-outline-secondary" @onclick='() => NavManager.NavigateTo("/")'>
                ← Regresar al Inicio
            </button>
        </div>
    </div>


    <div class="mb-3 d-flex align-items-center"> 
        <label class="form-label fw-semibold me-2 mb-0">Filtrar por estado:</label> 
        <select @onchange="OnStatusChanged" class="form-select w-auto">
            <option value="">Todos los estados</option>
            <option value="Activo">Activo</option> 
            <option value="Inactivo">Inactivo</option>
        </select>
    </div>

    <div class="table-responsive shadow-sm border rounded bg-white">
        <table class="table table-striped table-bordered align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Fecha de Nacimiento</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Fecha de Apareamiento</th>
                    <th scope="col">Crías</th>
                    <th scope="col" style="width: 100px;">Opciones</th> 
                </tr>
            </thead>
            <tbody>
                @if (tempReproductions != null && tempReproductions.Any()) 
                {
                    @foreach (var reproduction in tempReproductions)
                    {
                        <tr>
                            <td>@reproduction.IdBreeding</td>
                            <td>@(reproduction.Birthdate.ToString("dd/MM/yyyy"))</td> 
                            <td>
                                <span class="badge bg-@(reproduction.Status?.ToLower() == "activo" ? "success" : reproduction.Status?.ToLower() == "inactivo" ? "secondary" : "info")">
                                    @reproduction.Status
                                </span>
                            </td>
                            <td>@(reproduction.MatingDate.ToString("dd/MM/yyyy"))</td> 
                            <td>@reproduction.NumberOffspring</td>
                            <td>
                                <a class="btn btn-sm btn-primary w-100" href="@($"/Reproduction/update/{reproduction.IdBreeding}")">
                                    Editar
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No hay reproducciones disponibles.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<ReproductionsEntity> reproductions = new();
    private List<ReproductionsEntity> tempReproductions = new(); // Esta es la lista que se muestra en la tabla

    protected override async Task OnInitializedAsync()
    {
        await LoadReproductions();
    }

    private async Task LoadReproductions()
    {
        try
        {
            var reproductionsLog = new ReproductionsLog();
            reproductions = await Task.Run(() => reproductionsLog.ReproductionsList());
            
            // Ordenar al cargar inicialmente
            reproductions = reproductions.OrderBy(r => r.IdBreeding).ToList();
            
            // Asignar a tempReproductions para la visualización inicial
            tempReproductions = new List<ReproductionsEntity>(reproductions); // Crear una copia para evitar modificar la original directamente
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar reproducciones: {ex.Message}");
            // En caso de error, inicializa las listas para evitar NullReferenceException
            reproductions = new List<ReproductionsEntity>();
            tempReproductions = new List<ReproductionsEntity>();
        }
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        string? selectedStatus = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(selectedStatus))
        {
            // Si no hay filtro, mostrar todas las reproducciones de la lista original
            tempReproductions = new List<ReproductionsEntity>(reproductions); 
        }
        else
        {
            // Aplicar el filtro a la lista original 'reproductions'
            tempReproductions = reproductions.Where(r => r.Status?.Equals(selectedStatus, StringComparison.OrdinalIgnoreCase) == true).ToList();
        }

        // Asegurarse de que la lista filtrada también esté ordenada
        tempReproductions = tempReproductions.OrderBy(r => r.IdBreeding).ToList();
    }
}