@using Logic
@using Model
@inject NavigationManager NavManager

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-semibold">Actualizar Comprador</h4>
        <button class="btn btn-outline-secondary" @onclick="GoBackToList">
            ← Regresar
        </button>
    </div>

    @if (notFound)
    {
        <div class="alert alert-warning shadow-sm border rounded bg-white p-3">Comprador no encontrado.</div>
    }
    else if (objBuyer != null)
    {
        <div class="card shadow-sm border rounded bg-white">
            <div class="card-body">
                <EditForm Model="objBuyer" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre:</label>
                        <InputText class="form-control" @bind-Value="objBuyer.Name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cédula:</label>
                        <InputText class="form-control" @bind-Value="objBuyer.Cc" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Número de Teléfono:</label>
                        <InputText class="form-control" @bind-Value="objBuyer.PhoneNumber" />
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-primary me-md-2">Guardar Cambios</button>
                    </div>
                </EditForm>

                @if (!string.IsNullOrWhiteSpace(mensaje))
                {
                    <div class="alert @mensajeClase mt-3">@mensaje</div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info shadow-sm border rounded bg-white p-3">Cargando datos del comprador...</div>
    }
</div>

@code {
    [Parameter]
    public int IdBuyer { get; set; }

    private BuyersEntity? objBuyer;
    private bool notFound = false;
    private readonly BuyersLog buyersLog = new();

    private string mensaje = "";
    private string mensajeClase = "";

    protected override void OnInitialized()
    {
        objBuyer = buyersLog.GetBuyerById(IdBuyer);

        if (objBuyer == null)
        {
            notFound = true;
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            string resultado = buyersLog.UpdateBuyers(objBuyer!);

            if (resultado == "OK")
            {
                mensaje = "¡Comprador actualizado exitosamente!";
                mensajeClase = "alert alert-success";

                await InvokeAsync(StateHasChanged);
                await Task.Delay(1000);
                NavManager.NavigateTo("/buyer/list");
            }
            else
            {
                mensaje = resultado;
                mensajeClase = "alert alert-warning";
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error inesperado al intentar actualizar.";
            mensajeClase = "alert alert-danger";
            Console.WriteLine($"Error al actualizar el comprador: {ex.Message}");
        }
    }

    private void GoBackToList()
    {
        NavManager.NavigateTo("/buyer/list");
    }
}
